# Generated visual QA output is kept locally. Several captures are larger than
# GitHub's per-file limit and none is a source/master asset.
/evidence/

# Unapproved embedded-raster street-study draft (68.35 MiB). Keep the smaller
# concept renders and source notes; add a revised master only after approval.
/docs/ideas/street-study/manual-level50-v1.svg

# Separate local Sites deployment checkout. It has independent Git history and
# hosting metadata, and must never couple this source repository to deployment.
/sites/azmara-private-preview/

# Disposable visual-check screenshots and receipts (source runner is tracked).
prototype/debug/

# Build bundles inside evidence stay on the Mac and the encrypted USB backup,
# never in git — GitHub rejects files over 100 MB (Fable step 2, 2026-10-24).
evidence/**/*.tar.gz

# The private web preview is its own git repository — never nest it in this one
# (same pattern as ZYRA/SITE). Fable step 2, 2026-10-24.
sites/azmara-private-preview/
